digraph GovTrustFL_FederatedWorkflow {
    graph [
        rankdir=TB,
        compound=true,
        newrank=true,
        splines=ortho,
        bgcolor="white",
        margin=0.15,
        pad=0.20,
        nodesep=0.42,
        ranksep=0.56,
        fontname="Helvetica",
        fontsize=18,
        labelloc="t",
        label=<
            <B>Federated Learning Workflow</B>
        >
    ];

    node [
        shape=box,
        style="rounded,filled",
        fillcolor="#F7F7F7",
        color="#333333",
        penwidth=1.3,
        fontname="Helvetica",
        fontsize=12,
        margin="0.12,0.08"
    ];

    edge [
        color="#333333",
        arrowsize=0.8,
        fontname="Helvetica",
        fontsize=10
    ];

    SERVER [
        label=<
            <B>Global Server</B><BR/>
            Current global MLP
        >,
        fillcolor="#FFFFFF",
        penwidth=2.0,
        width=2.55
    ];

    SEND [
        label=<
            <B>Model Broadcast</B><BR/>
            Global weights sent to clients
        >,
        width=2.95
    ];

    NYC [
        label=<
            <B>NYC Client</B><BR/>
            Local training
        >,
        width=2.20
    ];

    CHI [
        label=<
            <B>Chicago Client</B><BR/>
            Local training
        >,
        width=2.20
    ];

    BOS [
        label=<
            <B>Boston Client</B><BR/>
            Local training
        >,
        width=2.20
    ];

    LOCAL_NOTE [
        label=<
            <B>Raw Records Remain Local</B><BR/>
            Only model updates leave each city
        >,
        fillcolor="#FFFFFF",
        penwidth=1.7,
        width=3.15
    ];

    DP [
        label=<
            <B>Optional DP Layer</B><BR/>
            Gradient clipping + Gaussian noise
        >,
        style="rounded,filled,dashed",
        fillcolor="#FFFFFF",
        penwidth=1.8,
        width=3.05
    ];

    SECAGG [
        label=<
            <B>Optional SecAgg Simulation</B><BR/>
            Communication overhead accounting
        >,
        style="rounded,filled,dashed",
        fillcolor="#FFFFFF",
        penwidth=1.8,
        width=3.20
    ];

    AGG [
        label=<
            <B>FedAvg / FedProx Aggregation</B><BR/>
            Weighted model-update aggregation
        >,
        width=3.35
    ];

    PROX [
        label=<
            <B>FedProx Objective</B><BR/>
            loss_total = loss_bce +<BR/>
            (mu/2)||w_local - w_global||^2
        >,
        style="rounded,filled,dashed",
        fillcolor="#FFFFFF",
        penwidth=1.8,
        width=3.35
    ];

    UPDATED [
        label=<
            <B>Updated Global Model</B><BR/>
            Next communication round
        >,
        fillcolor="#FFFFFF",
        penwidth=2.0,
        width=2.95
    ];

    SERVER -> SEND;
    SEND -> NYC;
    SEND -> CHI;
    SEND -> BOS;

    NYC -> LOCAL_NOTE;
    CHI -> LOCAL_NOTE;
    BOS -> LOCAL_NOTE;

    LOCAL_NOTE -> DP [label=<model updates>];
    DP -> SECAGG;
    SECAGG -> AGG;
    PROX -> AGG [style=dashed, arrowhead=none];
    AGG -> UPDATED;

    { rank=same; NYC; CHI; BOS; }
}
